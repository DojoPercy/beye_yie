# ── App ──────────────────────────────────────────────────────────────
PORT=3005
NODE_ENV=development

# ── Postgres (conversation memory, users, event log) ─────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/beye_yie

# ── LLM provider (grounded agent + red-flag backstop) ────────────────
# LLM_PROVIDER = OPENAI | OPENROUTER | GOOGLE
LLM_PROVIDER=OPENAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# ── Meta WhatsApp Cloud API ──────────────────────────────────────────
META_WHATSAPP_TOKEN=
# This is the Meta Phone Number ID (not the display phone number). The webhook
# ignores events addressed to other numbers in the same WhatsApp Business Account.
META_PHONE_NUMBER_ID=
# Required whenever META_WHATSAPP_TOKEN is set. Meta App Dashboard → App settings.
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=beye-yie-verify
WHATSAPP_SEND_TIMEOUT_MS=8000

# ── Voice notes (English-biased; Twi ASR is unreliable — see plan §06) ─
VOICE_NOTE_TRANSCRIPTION_ENABLED=false
VOICE_NOTE_TRANSCRIPTION_PROVIDER=openai
GROQ_API_KEY=

# ── Abena AI Text-to-Speech (Ghanaian voices) ─────────────────────────
# Free tier: 50 requests without API key, no sign-up required
# Get API key at https://abena.mobobi.com for higher limits and dashboard
ABENA_TTS_ENABLED=false
ABENA_TTS_API_KEY=
ABENA_TTS_DEFAULT_VOICE=abena_twi_high
# Available voices: abena_twi_high, abena_twi_lite, kobby_gpe, akua_eng, kwabena_eng
# Public base URL for audio files (required for WhatsApp media links)
PUBLIC_BASE_URL=https://your-domain.com

# ── Pre-rendered welcome audio (no per-worker TTS cost) ───────────────
# Prefer a Meta media ID. A public HTTPS URL is a development/staging fallback.
# Set exactly one source for each language; when omitted, onboarding stays text-only.
WELCOME_AUDIO_TW_MEDIA_ID=
WELCOME_AUDIO_EN_MEDIA_ID=
WELCOME_AUDIO_TW_URL=
WELCOME_AUDIO_EN_URL=

# ── Layer ③ human handoff — a REAL confirmed contact is required ──────
OT_HANDOFF_NAME=Ghana Health Service
OT_HANDOFF_CONTACT=+233-000-000-000

# ── Scheduler ────────────────────────────────────────────────────────
# Minutes between tip-scheduler sweeps
TIP_SCHEDULER_TICK_MINUTES=5
# Proactive daily tips — OFF until Meta approves the utility templates.
# Set to true only once tip.templateName is populated for the 9 tips.
TIP_SCHEDULER_ENABLED=false
# Weekly proactive check-in — also needs an approved template. Keep OFF.
WEEKLY_CHECKIN_ENABLED=false
