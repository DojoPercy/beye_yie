# ── App ──────────────────────────────────────────────────────────────
PORT=3005
NODE_ENV=development

# ── Postgres (conversation memory, users, event log) ─────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/beye_yie

# ── LLM provider (grounded agent + red-flag backstop) ────────────────
# LLM_PROVIDER = OPENAI | OPENROUTER | GOOGLE
LLM_PROVIDER=OPENAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# ── Meta WhatsApp Cloud API ──────────────────────────────────────────
META_WHATSAPP_TOKEN=
META_PHONE_NUMBER_ID=
META_WEBHOOK_VERIFY_TOKEN=beye-yie-verify
WHATSAPP_SEND_TIMEOUT_MS=8000

# ── Voice notes (English-biased; Twi ASR is unreliable — see plan §06) ─
VOICE_NOTE_TRANSCRIPTION_ENABLED=false
VOICE_NOTE_TRANSCRIPTION_PROVIDER=openai
GROQ_API_KEY=

# ── Layer ③ human handoff — a REAL confirmed contact is required ──────
OT_HANDOFF_NAME=Ghana Health Service
OT_HANDOFF_CONTACT=+233-000-000-000

# ── Scheduler ────────────────────────────────────────────────────────
# Minutes between tip-scheduler sweeps
TIP_SCHEDULER_TICK_MINUTES=5
